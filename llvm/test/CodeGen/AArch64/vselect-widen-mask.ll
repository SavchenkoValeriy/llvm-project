; CHECK:       // %bb.0:
; CHECK-NEXT:    fcmgt v2.4s, v1.4s, v0.4s
; CHECK-NEXT:    dup v2.4s, v2.s[1]
; CHECK-NEXT:    bif v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %cmp = fcmp olt <4 x float> %a, %b
