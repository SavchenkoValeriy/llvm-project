; Non-splat shuffle that's still optimizable
define <4 x i32> @shuffle_setcc_rev(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: shuffle_setcc_rev:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v2.4s, v0.4s, v1.4s
; CHECK-NEXT:    rev64 v2.4s, v2.4s
; CHECK-NEXT:    ext v2.16b, v2.16b, v2.16b, #8
; CHECK-NEXT:    bif v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %cmp = icmp sgt <4 x i32> %a, %b
  %rev = shufflevector <4 x i1> %cmp, <4 x i1> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
  %sel = select <4 x i1> %rev, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

