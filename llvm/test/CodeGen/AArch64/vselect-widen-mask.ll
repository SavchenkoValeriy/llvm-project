  %cmp = icmp ult <4 x i32> %a, %b
  %splat = shufflevector <4 x i1> %cmp, <4 x i1> poison, <4 x i32> <i32 3, i32 3, i32 3, i32 3>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

