;============================================================================
; NEGATIVE CASES: Optimization doesn't apply, falls back to trunc/ext
;============================================================================

; Mask from load - not a SETCC chain, must use extension
define <4 x i32> @mask_from_load(ptr %p, <4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: mask_from_load:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldrb w8, [x0]
; CHECK-NEXT:    ubfx w8, w8, #1, #1
; CHECK-NEXT:    dup v2.4h, w8
; CHECK-NEXT:    ushll v2.4s, v2.4h, #0
; CHECK-NEXT:    shl v2.4s, v2.4s, #31
; CHECK-NEXT:    cmlt v2.4s, v2.4s, #0
; CHECK-NEXT:    bif v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %mask = load <4 x i1>, ptr %p
  %splat = shufflevector <4 x i1> %mask, <4 x i1> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

; Mask from truncation of non-comparison - must use extension
define <4 x i32> @mask_from_trunc(<4 x i32> %x, <4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: mask_from_trunc:
; CHECK:       // %bb.0:
; CHECK-NEXT:    xtn v0.4h, v0.4s
; CHECK-NEXT:    dup v0.4h, v0.h[2]
; CHECK-NEXT:    ushll v0.4s, v0.4h, #0
; CHECK-NEXT:    shl v0.4s, v0.4s, #31
; CHECK-NEXT:    cmlt v0.4s, v0.4s, #0
; CHECK-NEXT:    bsl v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %trunc = trunc <4 x i32> %x to <4 x i1>
  %splat = shufflevector <4 x i1> %trunc, <4 x i1> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

; Mask from call - external source, must use extension
declare <4 x i1> @get_mask()
define <4 x i32> @mask_from_call(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: mask_from_call:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sub sp, sp, #48
; CHECK-NEXT:    str x30, [sp, #32] // 8-byte Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 48
; CHECK-NEXT:    .cfi_offset w30, -16
; CHECK-NEXT:    stp q0, q1, [sp] // 32-byte Folded Spill
; CHECK-NEXT:    bl get_mask
; CHECK-NEXT:    // kill: def $d0 killed $d0 def $q0
; CHECK-NEXT:    ldp q2, q1, [sp] // 32-byte Folded Reload
; CHECK-NEXT:    ldr x30, [sp, #32] // 8-byte Reload
; CHECK-NEXT:    dup v0.4h, v0.h[0]
; CHECK-NEXT:    ushll v0.4s, v0.4h, #0
; CHECK-NEXT:    shl v0.4s, v0.4s, #31
; CHECK-NEXT:    cmlt v0.4s, v0.4s, #0
; CHECK-NEXT:    bsl v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    add sp, sp, #48
; CHECK-NEXT:    ret
  %mask = call <4 x i1> @get_mask()
  %splat = shufflevector <4 x i1> %mask, <4 x i1> poison, <4 x i32> <i32 0, i32 0, i32 0, i32 0>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

; Mask from phi - DAG speculatively executes both branches and uses BIT/BIF
; to select, which still benefits from mask widening on each branch.
define <4 x i32> @mask_from_phi(i1 %cond, <4 x i32> %a, <4 x i32> %b, <4 x i32> %c) {
; CHECK-LABEL: mask_from_phi:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    tst w0, #0x1
; CHECK-NEXT:    cmgt v3.4s, v0.4s, v1.4s
; CHECK-NEXT:    cmgt v1.4s, v1.4s, v2.4s
; CHECK-NEXT:    csetm w8, ne
; CHECK-NEXT:    dup v4.4s, w8
; CHECK-NEXT:    bit v1.16b, v3.16b, v4.16b
; CHECK-NEXT:    dup v1.4s, v1.s[1]
; CHECK-NEXT:    bif v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    ret
entry:
  br i1 %cond, label %if.then, label %if.else

if.then:
  %cmp1 = icmp sgt <4 x i32> %a, %b
  br label %join

if.else:
  %cmp2 = icmp sgt <4 x i32> %b, %c
  br label %join

join:
  %mask = phi <4 x i1> [ %cmp1, %if.then ], [ %cmp2, %if.else ]
  %splat = shufflevector <4 x i1> %mask, <4 x i1> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %c
  ret <4 x i32> %sel
}

; Add of i1 values is equivalent to XOR, so this still gets optimized
define <4 x i32> @mask_from_add_setcc(<4 x i32> %a, <4 x i32> %b, <4 x i32> %c) {
; CHECK-LABEL: mask_from_add_setcc:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v3.4s, v0.4s, v1.4s
; CHECK-NEXT:    cmgt v1.4s, v1.4s, v2.4s
; CHECK-NEXT:    eor v1.16b, v3.16b, v1.16b
; CHECK-NEXT:    dup v1.4s, v1.s[2]
; CHECK-NEXT:    bif v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    ret
  %cmp1 = icmp sgt <4 x i32> %a, %b
  %cmp2 = icmp sgt <4 x i32> %b, %c
  %add = add <4 x i1> %cmp1, %cmp2
  %splat = shufflevector <4 x i1> %add, <4 x i1> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %c
  ret <4 x i32> %sel
}
