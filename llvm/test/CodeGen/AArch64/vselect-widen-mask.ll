; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64-linux-gnu < %s | FileCheck %s

; Tests for the WidenMaskArithmeticToVT optimization that keeps mask operations
; at the natural comparison width instead of narrowing to i16 and widening back.

;============================================================================
; POSITIVE CASES: Optimization applies, no xtn/sshll/ushll dance
;============================================================================

; Simple shuffle of SETCC - splat lane 2
define <4 x i32> @shuffle_setcc_splat(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: shuffle_setcc_splat:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v2.4s, v1.4s, v0.4s
; CHECK-NEXT:    dup v2.4s, v2.s[2]
; CHECK-NEXT:    bif v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %cmp = icmp slt <4 x i32> %a, %b
  %splat = shufflevector <4 x i1> %cmp, <4 x i1> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

; Simple shuffle of SETCC - splat lane 0
define <4 x i32> @shuffle_setcc_lane0(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: shuffle_setcc_lane0:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v2.4s, v0.4s, v1.4s
; CHECK-NEXT:    dup v2.4s, v2.s[0]
; CHECK-NEXT:    bif v0.16b, v1.16b, v2.16b
; CHECK-NEXT:    ret
  %cmp = icmp sgt <4 x i32> %a, %b
  %splat = shufflevector <4 x i1> %cmp, <4 x i1> poison, <4 x i32> <i32 0, i32 0, i32 0, i32 0>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %b
  ret <4 x i32> %sel
}

; AND of two SETCCs, then shuffle
define <4 x i32> @shuffle_and_setcc(<4 x i32> %a, <4 x i32> %b, <4 x i32> %c) {
; CHECK-LABEL: shuffle_and_setcc:
; CHECK:       // %bb.0:
; CHECK-NEXT:    smin v3.4s, v0.4s, v2.4s
; CHECK-NEXT:    cmgt v1.4s, v3.4s, v1.4s
; CHECK-NEXT:    dup v1.4s, v1.s[1]
; CHECK-NEXT:    bif v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    ret
  %cmp1 = icmp sgt <4 x i32> %a, %b
  %cmp2 = icmp slt <4 x i32> %b, %c
  %and = and <4 x i1> %cmp1, %cmp2
  %splat = shufflevector <4 x i1> %and, <4 x i1> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %c
  ret <4 x i32> %sel
}

; OR of two SETCCs, then shuffle
define <4 x i32> @shuffle_or_setcc(<4 x i32> %a, <4 x i32> %b, <4 x i32> %c) {
; CHECK-LABEL: shuffle_or_setcc:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmeq v3.4s, v0.4s, v1.4s
; CHECK-NEXT:    cmeq v1.4s, v1.4s, v2.4s
; CHECK-NEXT:    orr v1.16b, v3.16b, v1.16b
; CHECK-NEXT:    dup v1.4s, v1.s[3]
; CHECK-NEXT:    bif v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    ret
  %cmp1 = icmp eq <4 x i32> %a, %b
  %cmp2 = icmp eq <4 x i32> %b, %c
  %or = or <4 x i1> %cmp1, %cmp2
  %splat = shufflevector <4 x i1> %or, <4 x i1> poison, <4 x i32> <i32 3, i32 3, i32 3, i32 3>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %c
  ret <4 x i32> %sel
}

; XOR of two SETCCs, then shuffle
define <4 x i32> @shuffle_xor_setcc(<4 x i32> %a, <4 x i32> %b, <4 x i32> %c) {
; CHECK-LABEL: shuffle_xor_setcc:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v3.4s, v0.4s, v1.4s
; CHECK-NEXT:    cmgt v1.4s, v1.4s, v2.4s
; CHECK-NEXT:    eor v1.16b, v3.16b, v1.16b
; CHECK-NEXT:    dup v1.4s, v1.s[2]
; CHECK-NEXT:    bif v0.16b, v2.16b, v1.16b
; CHECK-NEXT:    ret
  %cmp1 = icmp sgt <4 x i32> %a, %b
  %cmp2 = icmp sgt <4 x i32> %b, %c
  %xor = xor <4 x i1> %cmp1, %cmp2
  %splat = shufflevector <4 x i1> %xor, <4 x i1> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %c
  ret <4 x i32> %sel
}

; Nested: shuffle of OR of ANDs of SETCCs
define <4 x i32> @shuffle_nested_logic(<4 x i32> %a, <4 x i32> %b, <4 x i32> %c, <4 x i32> %d) {
; CHECK-LABEL: shuffle_nested_logic:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmgt v4.4s, v1.4s, v2.4s
; CHECK-NEXT:    cmgt v5.4s, v0.4s, v1.4s
; CHECK-NEXT:    cmgt v2.4s, v2.4s, v3.4s
; CHECK-NEXT:    cmgt v1.4s, v3.4s, v1.4s
; CHECK-NEXT:    and v4.16b, v5.16b, v4.16b
; CHECK-NEXT:    and v1.16b, v2.16b, v1.16b
; CHECK-NEXT:    orr v1.16b, v4.16b, v1.16b
; CHECK-NEXT:    dup v1.4s, v1.s[1]
; CHECK-NEXT:    bif v0.16b, v3.16b, v1.16b
; CHECK-NEXT:    ret
  %cmp1 = icmp sgt <4 x i32> %a, %b
  %cmp2 = icmp sgt <4 x i32> %b, %c
  %and1 = and <4 x i1> %cmp1, %cmp2
  %cmp3 = icmp sgt <4 x i32> %c, %d
  %cmp4 = icmp sgt <4 x i32> %d, %b
  %and2 = and <4 x i1> %cmp3, %cmp4
  %or = or <4 x i1> %and1, %and2
  %splat = shufflevector <4 x i1> %or, <4 x i1> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %sel = select <4 x i1> %splat, <4 x i32> %a, <4 x i32> %d
  ret <4 x i32> %sel
}

